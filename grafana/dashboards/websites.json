      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "website_status_code",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 200,
                "color": "green"
              },
              {
                "value": 400,
                "color": "orange"
              },
              {
                "value": 500,
                "color": "red"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
