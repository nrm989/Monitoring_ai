{
  "title": "Websites MMSP (5 sites)",
  "uid": "websites-mmsp-idarati",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "panels": [
    {
      "id": 1,
      "title": "Etat actuel (UP=1 / DOWN=0)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "website_up",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ],
      "options": {
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 0.5,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Temps de réponse HTTP (s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus"
          },
          "expr": "website_response_time_seconds",
          "refId": "A",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Chatbot Idarati — test Bonjour (1=OK / 0=KO)",
